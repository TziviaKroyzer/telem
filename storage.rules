rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // קבצי מערכת הקבצים: files/{uid}/...
    match /files/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // קבצים מצורפים להערות
    match /commentsFiles/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
